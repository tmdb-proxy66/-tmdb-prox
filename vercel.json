{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/get/:path*",
      "destination": "https://api.themoviedb.org/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "https://image.tmdb.org/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
